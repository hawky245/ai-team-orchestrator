# Copy to .env and fill in your own values.
# .env is gitignored — never commit real keys.
#
# Any OpenAI-compatible provider works; the key prefix (nvapi-, gsk_,
# sk-or-, ...) auto-selects the matching endpoint.

# Provider API key(s). Comma-separated keys rotate round-robin.
LLM_API_KEY=your-api-key-here

# Model used by the planner (and as the default for every task).
LLM_MODEL_ID=meta/muse-glimmer-30b

# Endpoint for the key above. Omit to use the provider implied by the key prefix.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional: fallback model when the primary exhausts its retries.
# LLM_FALLBACK_MODEL_ID=

# Generation knobs
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8192

# Optional: SQLite location for run history (default: ./orchestrator.db)
# DB_PATH=
